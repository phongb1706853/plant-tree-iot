# Copy file này thành .env (đặt cạnh docker-compose.deploy.yml) và điền giá trị thật.
# Các giá trị MQTT/Mongo đã có default sẵn trong docker-compose.deploy.yml — chỉ cần
# khai báo ở đây khi muốn ghi đè.

# JWT — BẮT BUỘC ở Production (>= 32 ký tự). Thiếu -> server KHÔNG khởi động (fail-closed).
#   Sinh chuỗi: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# MQTT — HiveMQ Cloud (broker managed, chạy trên internet)
MQTT_BROKER=ba4fbc53bce842ffb0fcd51178d78414.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=nod-iot-plant
MQTT_PASSWORD=Nod-iot-plant1234
MQTT_USE_TLS=true
# Bỏ qua xác thực cert (trust store macOS thiếu CA của HiveMQ) — chỉ dùng dev
MQTT_ALLOW_INVALID_CERT=true

# MongoDB — trong stack Docker dùng service name 'mongodb', không phải localhost
# MONGO_URL=mongodb://mongodb:27017
